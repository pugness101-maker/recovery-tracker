# Recovery Tracker — optional cloud sync (Supabase)
# Copy to .env.local for local builds. Add the same public vars in Vercel.
# Never commit real keys. Never put SUPABASE_SERVICE_ROLE_KEY in client code.

# Public (safe in the browser / Capacitor webDir)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only (Edge Function / dashboard). NEVER ship this to the browser.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
